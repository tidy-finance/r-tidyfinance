# Compiled sources must keep LF endings: R CMD check tests "line endings in
# C/C++/Fortran sources/headers", and core.autocrlf would otherwise hand a
# Windows checkout CRLF files that fail that check.
*.c    text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.hpp  text eol=lf

# cpp11::cpp_register() writes LF. Pin the generated R file too, or a rerun
# shows the whole file as modified under core.autocrlf=true.
R/cpp11.R  text eol=lf

# make reads these literally, so a CR would end up inside a flag value.
src/Makevars*  text eol=lf
